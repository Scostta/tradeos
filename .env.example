# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API. La PUBLISHABLE key es la "anon"/publishable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (API routes / server actions). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Opcional ──────────────────────────────────────────────────────────────────
# Actualmente no se usa: el chart de ejecución consume Yahoo Finance (sin key)
# y cae a datos sintéticos si falla. Reservado por si se añade Polygon.
POLYGON_API_KEY=
