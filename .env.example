# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API. La PUBLISHABLE key es la "anon"/publishable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (API routes / server actions). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Insights (Anthropic) ───────────────────────────────────────────────────
# Pago APARTE (no usa tu suscripción de Claude). Crea una API key en
# console.anthropic.com y carga saldo. Sin esta key, la sección de AI Insights
# muestra un aviso de configuración y no llama a la API.
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-4-8. Sonnet (claude-sonnet-4-6) o
# Haiku (claude-haiku-4-5) abaratan el coste por análisis.

# ── Opcional ──────────────────────────────────────────────────────────────────
# Actualmente no se usa: el chart de ejecución consume Yahoo Finance (sin key)
# y cae a datos sintéticos si falla. Reservado por si se añade Polygon.
POLYGON_API_KEY=

# ── Invest screener (scripts/screener) ────────────────────────────────────────
# El job de Python NO lee este fichero: corre en GitHub Actions con los secrets
#   SUPABASE_URL                 (= NEXT_PUBLIC_SUPABASE_URL)
#   SUPABASE_SERVICE_ROLE_KEY    (= SUPABASE_SERVICE_ROLE_KEY)
# configurados en Settings → Secrets and variables → Actions. Ver
# scripts/screener/README.md.
